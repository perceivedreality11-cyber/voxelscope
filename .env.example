# Copy to .env and choose your own password before docker compose up --build.
# Never commit .env. These are initialization values, not a password reset mechanism.
VOXELSCOPE_ADMIN_EMAIL=admin@local
VOXELSCOPE_ADMIN_PASSWORD=replace-with-your-own-long-random-password
VOXELSCOPE_TENANT=Materials Inspection Team
SITE_HOST=localhost
PUBLIC_ORIGIN=https://localhost
